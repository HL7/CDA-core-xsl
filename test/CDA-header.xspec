                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="produces no output when no dataEnterer present">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3"/>
            </x:context>
            <x:call template="dataEnterer"/>
            <x:expect label="empty output" select="()"/>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- informant (document-level)                                          -->
    <!-- ================================================================== -->
    <x:scenario label="informant (document-level)">
        <x:scenario label="renders assignedEntity and relatedEntity informants">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <informant>
                        <!-- Copy of section-author, even though all pieces are not (currently) rendered -->
                        <assignedEntity>
                            <telecom value="mailto:jane@organization.com" use="WP"/>
                            <assignedPerson>
                                <name><given>Jane</given><family>Smith</family></name>
                                <desc>Jane's desc tag</desc>
                                <!-- Not actually allowed, but XSL renders it... -->
                                <birthTime value="20230102"/>
                            </assignedPerson>
                            <!-- Not displayed for informant -->
                            <code code="207Q00000X" codeSystem="2.16.840.1.113883.6.101" displayName="Family Medicine"/>
                            <representedOrganization>
                                <name>Good Health Clinic</name>
                                <telecom value="tel:800-111-1111" use="WP"/>
                            </representedOrganization>
                        </assignedEntity>
                    </informant>
                    <!-- ID-only assignedEntity -->
                    <informant>
                        <assignedEntity>
                            <id root="2.16.840.1.113883.19.5" extension="I-12345"/>
                        </assignedEntity>
                    </informant>
                    <!-- Related informant with code -->
                    <informant>
                        <relatedEntity classCode="PRS">
                            <code code="MTH" codeSystem="2.16.840.1.113883.5.111" displayName="Mother"/>
                            <telecom value="tel:555-123-4567" use="HP"/>
                            <relatedPerson>
                                <name><given>Mary</given><family>Jones</family></name>
                                <desc>Mary's description</desc>
                                <!-- Not actually allowed, but XSL renders it... -->
                                <birthTime value="20240404"/>
                            </relatedPerson>
                        </relatedEntity>
                    </informant>
                    <!-- Related informant with no code - falls back to classCode -->
                    <informant>
                        <relatedEntity classCode="CAREGIVER">
                            <relatedPerson>
                                <name><given>Karen</given><family>Giver</family></name>
                            </relatedPerson>
                        </relatedEntity>
                    </informant>
                </ClinicalDocument>
            </x:context>
            <x:call template="informant"/>
            <x:expect label="produces header_table with informant details">
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Informant</td>
                            <td style="width: 30%;">Jane  SMITH<div>Jane's desc tag</div> Date of Birth January  2, 2023 of Good Health Clinic</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>Mail Workplace: jane@organization.com</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Informant</td>
                            <td>
                                <span>I-12345 (2.16.840.1.113883.19.5)</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Informant</td>
                            <td style="width: 30%;">Mary  JONES<div>Mary's description</div> Date of Birth April  4, 2024</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>Tel Home Primary: 555-123-4567</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Informant</td>
                            <td>Karen  GIVER</td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="produces no output when no informants present">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3"/>
            </x:context>
            <x:call template="informant"/>
            <x:expect label="empty output" select="()"/>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- informationRecipient    (footer)                                   -->
    <!-- ================================================================== -->
    <x:scenario label="informationRecipient">
        <x:scenario label="renders recipient with name and organization">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <informationRecipient>
                        <intendedRecipient>
                            <addr>
                                <streetAddressLine>123 Info St.</streetAddressLine>
                            </addr>
                            <telecom value="tel:800-111-1234" />
                            <informationRecipient>
                                <name><given>Dr</given><given>Pat</given><family>Specialist</family></name>
                            </informationRecipient>
                            <receivedOrganization>
                                <name>Specialty Clinic</name>
                                <id root="2.16.840.1.113883.19.5" extension="ORG-1"/>
                            </receivedOrganization>
                        </intendedRecipient>
                    </informationRecipient>
                </ClinicalDocument>
            </x:context>
            <x:call template="informationRecipient"/>
            <x:expect label="produces header_table with recipient and org row">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Information Recipient</td>
                            <td style="width: 30%;">Dr  Pat  SPECIALIST</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>123 Info St.<br />Tel: 800-111-1234</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Organization</td>
                            <td style="width: 30%;">
                                <div>Specialty Clinic</div>
                                <table class="table_simple">
                                    <tbody>
                                        <tr>
                                            <td class="td_label">ID</td>
                                            <td><span>ORG-1 (2.16.840.1.113883.19.5)</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td class="td_label td_label_width">Contact Details (Organization)</td>
                            <td style="width: 30%;"/>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="renders recipient with id only (no name)">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <informationRecipient>
                        <intendedRecipient>
                            <id root="2.16.840.1.113883.19.5" extension="RECIP-99"/>
                        </intendedRecipient>
                    </informationRecipient>
                </ClinicalDocument>
            </x:context>
            <x:call template="informationRecipient"/>
            <x:expect label="produces header_table with id and trailing br">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Information Recipient</td>
                            <td colspan="3"><span>RECIP-99 (2.16.840.1.113883.19.5)</span><br/></td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="renders recipient with id only (no name)">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <informationRecipient>
                        <intendedRecipient>
                            <id root="2.16.840.1.113883.19.5" extension="RECIP-99"/>
                        </intendedRecipient>
                    </informationRecipient>
                </ClinicalDocument>
            </x:context>
            <x:call template="informationRecipient"/>
            <x:expect label="produces header_table with id and trailing br">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Information Recipient</td>
                            <td colspan="3"><span>RECIP-99 (2.16.840.1.113883.19.5)</span><br/></td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="produces no output when no recipients present">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3"/>
            </x:context>
            <x:call template="informationRecipient"/>
            <x:expect label="empty output" select="()"/>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- authenticator and legalAuthenticator (via show-authenticator)        -->
    <!-- ================================================================== -->
    <x:scenario label="authenticator">
        <x:scenario label="renders authenticator with signature and timestamp">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <authenticator>
                        <time value="20230615120000"/>
                        <signatureCode code="S"/>
                        <assignedEntity>
                            <assignedPerson>
                                <name><given>John</given><family>Reviewer</family></name>
                            </assignedPerson>
                        </assignedEntity>
                    </authenticator>
                </ClinicalDocument>
            </x:context>
            <x:call template="authenticator"/>
            <x:expect label="produces header_table with authenticator, signature, and time">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Authenticator</td>
                            <td>John  REVIEWER signed&#160;at&#160;June  15, 2023, 12AM</td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="renders authenticator with only a representedOrg name">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <authenticator>
                        <time value="20230615120000"/>
                        <signatureCode code="S"/>
                        <assignedEntity>
                            <representedOrganization>
                                <name>Signing Org</name>
                            </representedOrganization>
                        </assignedEntity>
                    </authenticator>
                </ClinicalDocument>
            </x:context>
            <x:call template="authenticator"/>
            <x:expect label="produces header_table with authenticator, signature, and time">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Authenticator</td>
                            <td>Signing Org signed&#160;at&#160;June  15, 2023, 12AM</td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <!-- TODO - add test with sdtc:signatureText but it doesn't have to be a full-match
             (the image is a bit obnoxious) -->
        
        <x:scenario label="produces no output when no authenticators present">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3"/>
            </x:context>
            <x:call template="authenticator"/>
            <x:expect label="empty output" select="()"/>
        </x:scenario>
    </x:scenario>
    
    <x:scenario label="legalAuthenticator">
        <x:scenario label="renders legalAuthenticator with signature and timestamp and code and contact details">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <legalAuthenticator>
                        <time value="20230615140000"/>
                        <signatureCode code="S"/>
                        <assignedEntity>
                            <code code="207QA0505X" displayName="Adult Medicine Physician"
                                codeSystem="2.16.840.1.113883.6.101"
                                codeSystemName="Healthcare Provider Taxonomy (HIPAA)"/>
                            <addr use="WP">
                                <streetAddressLine>1004 Healthcare Drive </streetAddressLine>
                                <city>Portland</city>
                            </addr>
                            <telecom use="WP" value="tel:+1(555)555-1004"/>
                            <assignedPerson>
                                <name><given>Sarah</given><family>Legal</family></name>
                            </assignedPerson>
                        </assignedEntity>
                    </legalAuthenticator>
                </ClinicalDocument>
            </x:context>
            <x:call template="legalAuthenticator"/>
            <x:expect label="produces header_table with legal authenticator, signature, and time">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Legal Authenticator</td>
                            <td style="width: 30%;">Sarah  LEGAL signed&#160;at&#160;June  15, 2023, 2PM</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>Workplace: 1004 Healthcare Drive <br />Portland<br />Tel Workplace: +1(555)555-1004</td>
                            
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
    </x:scenario>

    <!-- ================================================================== -->
    <!-- confidentiality template (DEAD CODE — never called)                -->
    <!-- Appears to have been intended for the document footer but was      -->
    <!-- never wired in. Also has a bug: no <tr> wrapping the <td>s.        -->
    <!-- ================================================================== -->
    <x:scenario label="confidentiality template (dead code)">
        <x:scenario label="renders confidentialityCode as a table">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <confidentialityCode code="R" displayName="Restricted" codeSystem="2.16.840.1.113883.5.25"/>
                </ClinicalDocument>
            </x:context>
            <x:call template="confidentiality"/>
            <!-- BUG: missing <tr> around the <td> elements — invalid HTML -->
            <x:expect label="produces table with label and code (no tr wrapper)">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <td class="td_label">Confidentiality</td>
                        <td style="width: 80%;">Restricted</td>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
    </x:scenario>

</x:description>
