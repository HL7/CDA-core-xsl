    <!-- ================================================================== -->
    <!-- authorization template                                             -->
    <!-- ================================================================== -->
    <x:scenario label="authorization template">
        <x:scenario label="renders authorization with code and statusCode fallback">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <!-- First: has code (takes the when branch) -->
                    <authorization>
                        <consent>
                            <code displayName="Consent for Treatment"/>
                        </consent>
                    </authorization>
                    <!-- Second: no code, only statusCode (takes the otherwise branch) -->
                    <authorization>
                        <consent>
                            <statusCode code="completed"/>
                        </consent>
                    </authorization>
                </ClinicalDocument>
            </x:context>
            <x:call template="authorization"/>
            <x:expect label="produces two consent tables">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Consent</td>
                            <td style="width: 80%;">Consent for Treatment<br/></td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Consent</td>
                            <td style="width: 80%;">completed<br/></td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
    </x:scenario>

    <!-- ================================================================== -->
    <!-- documentationOf template                                           -->
    <!-- ================================================================== -->
    <x:scenario label="documentationOf template">
        <x:scenario label="renders multiple documentationOf elements with performer contact variants">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <!-- Full: non-ACT classCode, code, time, two performers (one with telecom, one without) -->
                    <documentationOf>
                        <serviceEvent classCode="PCPR">
                            <code displayName="Primary Care"/>
                            <effectiveTime><low value="20260101"/><high value="20260901"/></effectiveTime>
                            <performer typeCode="PRF">
                                <functionCode code="PCP" displayName="Primary Care Provider"/>
                                <assignedEntity>
                                    <telecom value="tel:555-1234"/>
                                    <assignedPerson><name><given>Alice</given> <family>Doctor</family></name></assignedPerson>
                                </assignedEntity>
                            </performer>
                            <performer typeCode="SPRF">
                                <assignedEntity>
                                    <assignedPerson><name><given>Charlie</given> <family>Nurse</family></name></assignedPerson>
                                </assignedEntity>
                            </performer>
                        </serviceEvent>
                    </documentationOf>
                    <!-- ACT classCode, no performers, single effectiveTime -->
                    <documentationOf>
                        <serviceEvent classCode="ACT">
                            <code displayName="General Exam"/>
                            <effectiveTime value="20260901"/>
                        </serviceEvent>
                    </documentationOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="documentationOf"/>
            <x:expect label="produces two tables with performer contact details variants">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Documentation&#160;Of - care provision</td>
                            <td style="width: 80%;" colspan="3">Primary Carefrom&#160;January  1, 2026 to&#160;September  1, 2026</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Performer - Primary Care Provider</td>
                            <td style="width: 30%;">Alice  DOCTOR</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>Tel: 555-1234</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Secondary performer - </td>
                            <td colspan="3">Charlie  NURSE</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Documentation&#160;Of</td>
                            <td style="width: 80%;" colspan="3">General Examat&#160;September  1, 2026</td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- inFulfillmentOf template                                           -->
    <!-- ================================================================== -->
    <x:scenario label="inFulfillmentOf template">
        <x:scenario label="renders multiple inFulfillmentOf elements">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <!-- Full: id, code, priorityCode -->
                    <inFulfillmentOf>
                        <order>
                            <id root="2.16.840.1.113883.19.5" extension="ORD-1"/>
                            <code displayName="Lab Order"/>
                            <priorityCode displayName="Routine"/>
                        </order>
                    </inFulfillmentOf>
                    <!-- Minimal: id only -->
                    <inFulfillmentOf>
                        <order>
                            <id root="2.16.840.1.113883.19.5" extension="ORD-2"/>
                        </order>
                    </inFulfillmentOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="inFulfillmentOf"/>
            <x:expect label="produces two tables for each order">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">In Fulfillment Of</td>
                            <td style="width: 80%;">Order: <span>ORD-1 (2.16.840.1.113883.19.5)</span>&#160;Lab Order&#160;Routine</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">In Fulfillment Of</td>
                            <td style="width: 80%;">Order: <span>ORD-2 (2.16.840.1.113883.19.5)</span></td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
    </x:scenario>

    <!-- ================================================================== -->
    <!-- componentOf template                                               -->
    <!-- ================================================================== -->
    <x:scenario label="componentOf template">
        <x:scenario label="renders comprehensive encounter with all fields">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc">
                    <componentOf>
                        <encompassingEncounter>
                            <id root="2.16.840.1.113883.19.5" extension="ENC-001"/>
                            <code displayName="Inpatient"/>
                            <effectiveTime><low value="20260101"/><high value="20260115"/></effectiveTime>
                            <dischargeDispositionCode displayName="Home"/>
                            <sdtc:admissionReferralSourceCode displayName="Emergency Room"/>
                            <location>
                                <healthCareFacility>
                                    <location>
                                        <name>West Wing ICU</name>
                                        <addr><city>Anytown</city></addr>
                                    </location>
                                    <serviceProviderOrganization>
                                        <name>General Hospital</name>
                                    </serviceProviderOrganization>
                                </healthCareFacility>
                            </location>
                            <responsibleParty>
                                <assignedEntity>
                                    <telecom value="tel:555-1111"/>
                                    <assignedPerson><name><given>Alice</given> <family>Responsible</family></name></assignedPerson>
                                </assignedEntity>
                            </responsibleParty>
                            <encounterParticipant typeCode="ATND">
                                <time><low value="20260101"/><high value="20260108"/></time>
                                <assignedEntity>
                                    <telecom value="tel:555-2222"/>
                                    <assignedPerson><name><given>Bob</given> <family>Attending</family></name></assignedPerson>
                                </assignedEntity>
                            </encounterParticipant>
                        </encompassingEncounter>
                    </componentOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="componentOf"/>
            <!-- BUG: serviceProviderOrganization/name outputs "&#160;of&#160;" but not the org name.
                 The for-each iterates over the name element, then show-name-set uses an absolute path
                 hl7:location/hl7:healthCareFacility/hl7:serviceProviderOrganization/hl7:name relative
                 to the name context, which doesn't match. Should use select="." instead. -->
            <x:expect label="produces full encounter table">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Encounter</td>
                            <td style="width: 30%;">
                                <table class="table_simple">
                                    <tbody>
                                        <tr>
                                            <td class="td_label">ID</td>
                                            <td><span>ENC-001 (2.16.840.1.113883.19.5)</span></td>
                                        </tr>
                                        <tr>
                                            <td class="td_label">Type</td>
                                            <td>Inpatient</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td class="td_label td_label_width">Encounter Date</td>
                            <td>from&#160;January  1, 2026 to&#160;January  15, 2026</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Admission Referral Source</td>
                            <td style="width: 30%;">Emergency Room</td>
                            <td class="td_label td_label_width">Discharge Disposition</td>
                            <td style="width: 30%;">Home</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Encounter Location</td>
                            <td colspan="3">West Wing ICU (Anytown)&#160;of&#160;</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Responsible Party</td>
                            <td style="width: 30%;">Alice  RESPONSIBLE</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>Tel: 555-1111</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">attender (from&#160;January  1, 2026 to&#160;January  8, 2026)</td>
                            <td style="width: 30%;">Bob  ATTENDING</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>Tel: 555-2222</td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>

        <x:scenario label="renders dischargeDisposition without admissionReferralSourceCode">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <componentOf>
                        <encompassingEncounter>
                            <id root="1.2.3" extension="ENC-002"/>
                            <effectiveTime value="20260901"/>
                            <dischargeDispositionCode displayName="Home"/>
                        </encompassingEncounter>
                    </componentOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="componentOf"/>
            <!-- Without admissionReferralSourceCode, discharge gets colspan="3" -->
            <x:expect label="discharge disposition spans full width"
                      test="$x:result//xhtml:tr[xhtml:td = 'Discharge Disposition']">
                <tr xmlns="http://www.w3.org/1999/xhtml">
                    <td class="td_label td_label_width">Discharge Disposition</td>
                    <td colspan="3">Home</td>
                </tr>
            </x:expect>
        </x:scenario>

        <x:scenario label="renders location with code, no name">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <componentOf>
                        <encompassingEncounter>
                            <id root="1.2.3" extension="ENC-003"/>
                            <location>
                                <healthCareFacility>
                                    <code displayName="Emergency Department"/>
                                </healthCareFacility>
                            </location>
                        </encompassingEncounter>
                    </componentOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="componentOf"/>
            <x:expect label="location row shows code displayName"
                      test="$x:result//xhtml:tr[xhtml:td = 'Encounter Location']">
                <tr xmlns="http://www.w3.org/1999/xhtml">
                    <td class="td_label td_label_width">Encounter Location</td>
                    <td colspan="3">Emergency Department</td>
                </tr>
            </x:expect>
        </x:scenario>

        <x:scenario label="renders location with id, no name or code">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <componentOf>
                        <encompassingEncounter>
                            <id root="1.2.3" extension="ENC-004"/>
                            <location>
                                <healthCareFacility>
                                    <id root="2.16.840.1.113883.19.5" extension="LOC-1"/>
                                </healthCareFacility>
                            </location>
                        </encompassingEncounter>
                    </componentOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="componentOf"/>
            <x:expect label="location row shows ID label and id"
                      test="$x:result//xhtml:tr[xhtml:td = 'Encounter Location']">
                <tr xmlns="http://www.w3.org/1999/xhtml">
                    <td class="td_label td_label_width">Encounter Location</td>
                    <td colspan="3">ID:<span>LOC-1 (2.16.840.1.113883.19.5)</span></td>
                </tr>
            </x:expect>
        </x:scenario>

        <x:scenario label="renders responsibleParty without addr or telecom">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <componentOf>
                        <encompassingEncounter>
                            <id root="1.2.3" extension="ENC-005"/>
                            <responsibleParty>
                                <assignedEntity>
                                    <assignedPerson><name><given>Solo</given> <family>Doctor</family></name></assignedPerson>
                                </assignedEntity>
                            </responsibleParty>
                        </encompassingEncounter>
                    </componentOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="componentOf"/>
            <!-- Without addr/telecom, name td gets colspan="3" and no Contact Details cells -->
            <x:expect label="responsible party row has colspan 3 and no contact details"
                      test="$x:result//xhtml:tr[xhtml:td = 'Responsible Party']">
                <tr xmlns="http://www.w3.org/1999/xhtml">
                    <td class="td_label td_label_width">Responsible Party</td>
                    <td colspan="3">Solo  DOCTOR</td>
                </tr>
            </x:expect>
        </x:scenario>

        <x:scenario label="renders encounterParticipant without addr or telecom">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <componentOf>
                        <encompassingEncounter>
                            <id root="1.2.3" extension="ENC-006"/>
                            <encounterParticipant typeCode="CON">
                                <assignedEntity>
                                    <assignedPerson><name><given>Jane</given> <family>Consultant</family></name></assignedPerson>
                                </assignedEntity>
                            </encounterParticipant>
                        </encompassingEncounter>
                    </componentOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="componentOf"/>
            <!-- Without addr/telecom, name td gets colspan="3" and no Contact Details cells -->
            <x:expect label="participant row has colspan 3 and no contact details"
                      test="$x:result//xhtml:tr[xhtml:td = 'consultant']">
                <tr xmlns="http://www.w3.org/1999/xhtml">
                    <td class="td_label td_label_width">consultant</td>
                    <td colspan="3">Jane  CONSULTANT</td>
                </tr>
            </x:expect>
        </x:scenario>
    </x:scenario>
    
    <!--
        These templates operate on the ClinicalDocument context node and render
        participant information as table.header_table structures (contrast with
        the section-level templates in CDA-section.xspec which render as div/ul/li).
    -->
    
    <!-- ================================================================== -->
    <!-- author  (footer)                                                   -->
    <!-- ================================================================== -->
    <x:scenario label="author">
        <x:scenario label="renders person author with org and code">
            <x:context>
                <!-- Keep authors in-sync with CDA-section section-author block -->
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <author>
                        <assignedAuthor>
                            <id root="2.16.840.1.113883.19.5" extension="A-12345"/>
                            <telecom value="mailto:jane@organization.com" use="WP"/>
                            <addr>
                                <streetAddressLine>123 Main St.</streetAddressLine>
                                <city>Anywhere</city>
                            </addr>
                            <assignedPerson>
                                <name><given>Jane</given><family>Smith</family></name>
                                <desc>Jane's desc tag</desc>
                                <!-- Not actually allowed, but XSL renders it... -->
                                <birthTime value="20230102"/>
                            </assignedPerson>
                            <code code="207Q00000X" codeSystem="2.16.840.1.113883.6.101" displayName="Family Medicine"/>
                            <representedOrganization>
                                <id root="2.3.4" extension="org1"/>
                                <name>Good Health Clinic</name>
                                <addr>
                                    <streetAddressLine>100 Medical Circle</streetAddressLine>
                                    <city>Healing Springs</city>
                                </addr>
                                <!-- Doesn't render (yet) for section-author -->
                                <telecom value="tel:800-111-1111" use="WP"/>
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                    <!-- Device with software name -->
                    <author>
                        <assignedAuthor>
                            <assignedAuthoringDevice>
                                <softwareName>Clinical Documentation System v3.2</softwareName>
                            </assignedAuthoringDevice>
                            <representedOrganization>
                                <id root="2.16.840.1.113883.19.5" extension="O-123"/>
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                    <!-- CDAr3 <assignedDevice> -->
                    <author>
                        <assignedAuthor>
                            <assignedDevice>
                                <softwareName value="Unreleased But Supported" />
                            </assignedDevice>
                        </assignedAuthor>
                    </author>
                    <!-- ID-only author (XSL pulls org name from representedOrg with matching name - weird, but test it)-->
                    <author>
                        <assignedAuthor>
                            <id root="2.16.840.1.113883.19.5" extension="A-12345"/>
                            <representedOrganization>
                                <id root="2.3.4" extension="org1"/>
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                    <!-- ID-only author
                        NOTE: this one is even weirder and probably incorrect. If the org id has no extension,
                        it'll match on another ID's root even if THAT id has an extension.
                    -->
                    <author>
                        <assignedAuthor>
                            <id root="2.16.840.1.113883.19.5" extension="A-12345"/>
                            <representedOrganization>
                                <id root="2.3.4"/>
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                </ClinicalDocument>
            </x:context>
            <x:call template="author"/>
            <x:expect label="produces header_table with author details">
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width" rowspan="2">Author</td>
                            <td style="width: 30%;" rowspan="2">Jane  SMITH<div>Jane's desc tag</div> Date of Birth January  2, 2023 - Code: Family Medicine, Organization: Good Health Clinic</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>123 Main St.<br />Anywhere<br />Mail Workplace: jane@organization.com</td>
                            
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Contact Details (Organization)</td>
                            <td>100 Medical Circle<br />Healing Springs<br />Tel Workplace: 800-111-1111</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Author</td>
                            <td colspan="3">Clinical Documentation System v3.2, Organization: <span>O-123 (2.16.840.1.113883.19.5)</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Author</td>
                            <td colspan="3">Unreleased But Supported</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Author</td>
                            <td colspan="3">, Organization: Good Health Clinic</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml"
                    class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Author</td>
                            <td colspan="3">, Organization: Good Health Clinic</td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="produces no output when no authors present">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3"/>
            </x:context>
            <x:call template="author"/>
            <x:expect label="empty output" select="()"/>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- participant  (footer)                                              -->
    <!-- ================================================================== -->
    <x:scenario label="participant">
        <x:scenario label="renders multiple participants covering all branches">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <!-- 1. typeCode+classCode label, functionCode, person with desc+birthTime+addr+telecom
                         BUG: desc and birthTime silently ignored — show-associatedEntity checks
                         hl7:assignedPerson/hl7:desc and hl7:assignedPerson/hl7:birthTime but the
                         element is hl7:associatedPerson (wrong element name). -->
                    <participant typeCode="IND">
                        <functionCode code="FUN" displayName="Fun"/>
                        <associatedEntity classCode="NOK">
                            <id root="1.2.3" extension="NOK-1"/>
                            <code code="test" codeSystem="1.2.3" />
                            <addr><streetAddressLine>123 Assoc Ave.</streetAddressLine></addr>
                            <telecom value="tel:800-1231-7654"/>
                            <associatedPerson>
                                <name><given>Ellen</given><family>Kin</family></name>
                                <desc>Ellen description</desc>
                                <birthTime value="19700301"/>
                            </associatedPerson>
                        </associatedEntity>
                    </participant>
                    <!-- 2. No addr/telecom (no Contact Details), time, code,
                         scopingOrg with name + standardIndustryClassCode + id -->
                    <participant typeCode="HLD">
                        <time><low value="20260101"/><high value="20260901"/></time>
                        <associatedEntity classCode="POLHOLD">
                            <code displayName="Health Insurance"/>
                            <associatedPerson>
                                <name><given>Sam</given><family>Holder</family></name>
                            </associatedPerson>
                            <scopingOrganization>
                                <id root="2.16.840.1.113883.19.5" extension="ORG-INS"/>
                                <name>Acme Insurance</name>
                                <standardIndustryClassCode code="524114" displayName="Health Insurance Carriers"/>
                            </scopingOrganization>
                        </associatedEntity>
                    </participant>
                    <!-- 3. ID-only (no person), scopingOrg with ONLY standardIndustryClassCode + id -->
                    <participant typeCode="IND">
                        <associatedEntity classCode="GUAR">
                            <id root="2.16.840.1.113883.19.5" extension="G-001"/>
                            <scopingOrganization>
                                <id root="9.8.7" extension="SCOPE-1"/>
                                <standardIndustryClassCode code="621111" displayName="Offices of Physicians"/>
                            </scopingOrganization>
                        </associatedEntity>
                    </participant>
                    <!-- 4. No typeCode/classCode → fallback "participant" label -->
                    <participant>
                        <associatedEntity>
                            <associatedPerson>
                                <name><given>Jane</given><family>Unknown</family></name>
                            </associatedPerson>
                        </associatedEntity>
                    </participant>
                </ClinicalDocument>
            </x:context>
            <x:call template="participant"/>
            <x:expect label="produces four tables covering all participant branches">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Indirect target - next of kin test</td>
                            <td style="width: 30%;">Fun, Ellen  KIN, test, ID: <span>NOK-1 (1.2.3)</span></td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>123 Assoc Ave.<br/>Tel: 800-1231-7654</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Holder - policy holder</td>
                            <td>Sam  HOLDER, Health Insurance<br/>Organization: Acme InsuranceHealth Insurance Carriers Code:, ID: <span>ORG-INS (2.16.840.1.113883.19.5)</span>from&#160;January  1, 2026 to&#160;September  1, 2026</td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Indirect target - 2.16.840.1.113883.5.110-GUAR</td>
                            <td>ID: <span>G-001 (2.16.840.1.113883.19.5)</span><br/>Organization: Offices of Physicians Code:, ID: <span>SCOPE-1 (9.8.7)</span></td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">participant</td>
                            <td>Jane  UNKNOWN</td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="produces no output when no participants present">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3"/>
            </x:context>
            <x:call template="participant"/>
            <x:expect label="empty output" select="()"/>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- dataEnterer    (footer)                                            -->
    <!-- ================================================================== -->
