<?xml version="1.0" encoding="UTF-8"?>
<!--
    XSpec tests for CDA.xsl — Header-level templates
    
-->
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:hl7="urn:hl7-org:v3"
               xmlns:sdtc="urn:hl7-org:sdtc"
               xmlns:xhtml="http://www.w3.org/1999/xhtml"
               stylesheet="../CDA.xsl">

    <x:import href="CDA-shared-params.xspec"/>
    <!-- currentDate is needed for age calculation; normally resolved from 
         /hl7:ClinicalDocument/hl7:effectiveTime/@value but absent with x:call template -->
    <x:param name="currentDate" select="'20260901'"/>
    <!-- Just adds some CSS to header -->
    <x:param name="externalCss" select="'externalTest.css'"/>
    
    <!-- ================================================================== -->
    <!-- Basic Checks                                                       -->
    <!-- ================================================================== -->
    <x:scenario label="header general structure">
        <x:context>
            <ClinicalDocument xmlns="urn:hl7-org:v3">
                <component>
                    <structuredBody>
                        <component>
                            <section><text><content revised="delete"/></text></section>
                        </component>
                    </structuredBody>
                </component>
            </ClinicalDocument>
        </x:context>
        <x:scenario label="hard-coded elements">
            <x:expect label="one html exists" test="count(//xhtml:html) = 1" />
            <x:expect label="one head exists" test="count(//xhtml:head) = 1" />
            <x:expect label="one body exists" test="count(//xhtml:body) = 1" />
            <!-- This is silly, but testing existing structure -->
            <x:expect label="at least one style exists" test="count(//xhtml:style) >= 1" />
            <x:expect label="one documentheader exists" test="count(//xhtml:div[@id='documentheader']) = 1"/>
            <x:expect label="buttontable exists" test="count(//xhtml:div[@id='buttontable']) = 1"/>
            <x:expect label="one documentbody exists"   test="count(//xhtml:div[@id='documentbody']) = 1"/>
            <x:expect label="one documentfooter exists" test="count(//xhtml:div[@id='documentfooter']) = 1"/>
            <x:expect label="footer contains at least 3 separators" test="count(//xhtml:div[@id='documentfooter']/xhtml:div[@class='separator']) >= 3"/>
        </x:scenario>
        
        <x:scenario label="simple params">
            <x:expect label="externalCss exists" test="exists(//xhtml:link[@href='externalTest.css'])"/>
        </x:scenario>
        
        <!-- <x:expect label="test"></x:expect> -->
    </x:scenario>
        
    <!-- ================================================================== -->
    <!-- show-title template                                                -->
    <!-- ================================================================== -->
    <x:scenario label="document title">
        <x:scenario label="standard title">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <title>Standard Title</title>
                    <effectiveTime value="20260901143208"/> <!-- -0500 just displays -0500 - suboptimal -->
                </ClinicalDocument>
            </x:context>
            <x:expect label="html title shows standard title" test="//xhtml:title/text()">Standard Title (September 1, 2026, 2:32:08PM)</x:expect>
            <x:expect label="doc title shows standard title" test="//xhtml:div[@id='documentheader']/xhtml:h1/text()">Standard Title (September 1, 2026, 2:32:08PM)</x:expect>
        </x:scenario>
        <x:scenario label="DTr2 title">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <title value="DTr2 Title"/>
                    <effectiveTime value="20260901143208"/> <!-- -0500 just displays -0500 - suboptimal -->
                </ClinicalDocument>
            </x:context>
            <x:expect label="html title shows DTr2 title" test="//xhtml:title/text()">DTr2 Title (September 1, 2026, 2:32:08PM)</x:expect>
            <x:expect label="doc title shows DTr2 title" test="//xhtml:div[@id='documentheader']/xhtml:h1/text()">DTr2 Title (September 1, 2026, 2:32:08PM)</x:expect>
        </x:scenario>
        <x:scenario label="fallback to code if title is empty">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <code displayName="CCD"/>
                    <title></title>
                    <effectiveTime value="20260901143208"/> <!-- -0500 just displays -0500 - suboptimal -->
                </ClinicalDocument>
            </x:context>
            <x:expect label="html title shows code" test="//xhtml:title/text()">CCD (September 1, 2026, 2:32:08PM)</x:expect>
            <x:expect label="doc title shows code" test="//xhtml:div[@id='documentheader']/xhtml:h1/text()">CCD (September 1, 2026, 2:32:08PM)</x:expect>
        </x:scenario>
        <x:scenario label="fallback to code (DTr2) if title is empty">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <code><displayName value="DTr2 Code" /></code>
                    <title></title>
                    <effectiveTime value="20260901143208"/> <!-- -0500 just displays -0500 - suboptimal -->
                </ClinicalDocument>
            </x:context>
            <x:expect label="html title shows DTr2 code" test="//xhtml:title/text()">DTr2 Code (September 1, 2026, 2:32:08PM)</x:expect>
            <x:expect label="doc title shows DTr2 code" test="//xhtml:div[@id='documentheader']/xhtml:h1/text()">DTr2 Code (September 1, 2026, 2:32:08PM)</x:expect>
        </x:scenario>
        <x:scenario label="Clinical Document if no title or code displayName">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <code cod="34133-9"/> <!-- Seems like we could look this up; but most docs already have a title, so not really worth it? -->
                    <title></title>
                    <effectiveTime value="20260901143208"/> <!-- -0500 just displays -0500 - suboptimal -->
                </ClinicalDocument>
            </x:context>
            <x:expect label="html title shows 'Clinical Document'" test="//xhtml:title/text()">Clinical Document (September 1, 2026, 2:32:08PM)</x:expect>
            <x:expect label="doc title shows 'Clinical Document'" test="//xhtml:div[@id='documentheader']/xhtml:h1/text()">Clinical Document (September 1, 2026, 2:32:08PM)</x:expect>
        </x:scenario>
        
        <x:scenario label="title with non-N confidentiality code">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <title>Standard Title</title>
                    <effectiveTime value="20260901143208"/> <!-- -0500 just displays -0500 - suboptimal -->
                    <confidentialityCode code="V" codeSystem="2.16.840.1.113883.5.25"/>
                </ClinicalDocument>
            </x:context>
            <x:expect label="html title shows ...too much" test="//xhtml:title/text()">Standard Title (September 1, 2026, 2:32:08PM  Very restricted)</x:expect>
            <x:expect label="doc title shows title with confidentiality image" test="//xhtml:div[@id='documentheader']/xhtml:h1/text()">Standard Title (September 1, 2026, 2:32:08PM  Very restricted)</x:expect>
        </x:scenario>
        
        <x:scenario label="title with non-standard confidentiality code">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <title>Standard Title</title>
                    <effectiveTime value="20260901143208"/> <!-- -0500 just displays -0500 - suboptimal -->
                    <confidentialityCode code="secret" codeSystem="2.3.4"/>
                </ClinicalDocument>
            </x:context>
            <x:expect label="html title shows ...too much" test="//xhtml:title/text()">Standard Title (September 1, 2026, 2:32:08PM  secret (2.3.4))</x:expect>
            <x:expect label="doc title shows title with confidentiality image" test="//xhtml:div[@id='documentheader']/xhtml:h1/text()">Standard Title (September 1, 2026, 2:32:08PM  secret (2.3.4))</x:expect>
        </x:scenario>
        <!--
        <x:expect label="test"></x:expect> -->
    </x:scenario>
    
    
    <!-- Header -->
    <!-- ================================================================== -->
    <!-- show-header template                                                -->
    <!-- ================================================================== -->
    <x:scenario label="show-header">
        <x:scenario label="renders full header with all major sections">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget>
                        <patientRole>
                            <id root="2.16.840.1.113883.19.5" extension="P-001"/>
                            <patient>
                                <name><given>Jane</given><family>Doe</family></name>
                                <birthTime value="19900115"/>
                                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" displayName="Female"/>
                                <guardian>
                                    <code code="GRPRN" displayName="Grandparent"/>
                                    <guardianPerson>
                                        <name><given>Bob</given><family>Guardian</family></name>
                                    </guardianPerson>
                                </guardian>
                            </patient>
                        </patientRole>
                    </recordTarget>
                    <authorization>
                        <consent>
                            <id root="2.16.840.1.113883.19.5" extension="CONSENT-1"/>
                            <code displayName="Consent Given"/>
                            <statusCode code="completed"/>
                        </consent>
                    </authorization>
                    <componentOf>
                        <encompassingEncounter>
                            <id root="2.16.840.1.113883.19.5" extension="ENC-1"/>
                            <code displayName="Office Visit"/>
                            <effectiveTime value="20260901"/>
                            <location>
                                <healthCareFacility>
                                    <code displayName="General Medicine Clinic"/>
                                </healthCareFacility>
                            </location>
                        </encompassingEncounter>
                    </componentOf>
                    <documentationOf>
                        <serviceEvent classCode="PCPR">
                            <code displayName="Primary Care"/>
                            <effectiveTime><low value="20260101"/><high value="20260901"/></effectiveTime>
                            <performer typeCode="PRF">
                                <assignedEntity>
                                    <assignedPerson><name><given>Alice</given><family>Doctor</family></name></assignedPerson>
                                </assignedEntity>
                            </performer>
                            <performer typeCode="SPRF">
                                <assignedEntity>
                                    <assignedPerson><name><given>Charlie</given><family>Nurse</family></name></assignedPerson>
                                </assignedEntity>
                            </performer>
                        </serviceEvent>
                    </documentationOf>
                    <inFulfillmentOf>
                        <order>
                            <id root="2.16.840.1.113883.19.5" extension="ORD-1"/>
                            <code displayName="Lab Order"/>
                            <priorityCode displayName="Routine"/>
                        </order>
                    </inFulfillmentOf>
                    <author>
                        <time value="20260901"/>
                        <assignedAuthor>
                            <assignedPerson>
                                <name><given>Alice</given><family>Doctor</family></name>
                                <desc>Board Certified</desc>
                                <birthTime value="19800601"/>
                            </assignedPerson>
                            <representedOrganization>
                                <name>Good Health Clinic</name>
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="produces complete header table">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label">Patient</td>
                            <td>
                                <span class="span_value">Jane  DOE</span>
                                <span style="float: right; margin-left: 1em;">
                                    <span>
                                        <span class="span_label">Date of Birth: </span>
                                        <span class="span_value">January  15, 1990<span title="At document creation time"> (36yr)</span></span>
                                    </span>
                                    <span class="span_label">Gender: </span>
                                    <span class="span_value">Female</span>
                                </span>
                                <span style="float: right;" class="print_visible">
                                    <span class="span_label">Patient-ID:&#160;</span>
                                    <span class="span_value"><span>P-001 (2.16.840.1.113883.19.5)</span></span>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="td_label">Guardian</td>
                            <td>
                                <span class="span_value">Bob  GUARDIAN - Grandparent</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="td_label">Consent</td>
                            <td>
                                <span class="span_label">ID: </span>
                                <span class="span_value"><span>CONSENT-1 (2.16.840.1.113883.19.5)</span></span>, <span class="span_label">Code: </span>
                                <span class="span_value">Consent Given</span>, <span class="span_label">Status: </span>
                                <span class="span_value">completed</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="td_label">Encounter</td>
                            <td>
                                <span class="span_label">ID: </span>
                                <span class="span_value"><span>ENC-1 (2.16.840.1.113883.19.5)</span></span>, <span class="span_label">Type: </span>
                                <span class="span_value">Office Visit</span>, <span class="span_label">Date/Time: </span>
                                <span class="span_value">at&#160;September  1, 2026</span>
                                <div>
                                    <span class="span_label">Location: </span>
                                    <span class="span_value">General Medicine Clinic</span>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="td_label">Documentation&#160;Of</td>
                            <td>Care provision, <span class="span_value">Primary Care</span>, <span class="span_label">Date/Time: </span>
                                <span class="span_value">from&#160;January  1, 2026 to&#160;September  1, 2026</span>, <span class="span_label">Performer: </span>
                                <span class="span_value">Alice  DOCTOR</span>, <span class="span_label">Supporting Performer: </span>
                                <span class="span_value">Charlie  NURSE</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="td_label">In Fulfillment Of</td>
                            <td>
                                <span class="span_label">Order </span>
                                <span class="span_label">ID: </span>
                                <span class="span_value"><span>ORD-1 (2.16.840.1.113883.19.5)</span></span>, <span class="span_label">Code: </span>
                                <span class="span_value">Lab Order</span>, <span class="span_label">Priority: </span>
                                <span class="span_value">Routine</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="td_label">Author</td>
                            <td>
                                <span class="span_value">Alice  DOCTOR<div>Board Certified</div> Date of Birth June  1, 1980</span>, <span class="span_label">Organization: </span>
                                <span class="span_value">Good Health Clinic</span>, <span class="span_label">Authored On: </span>
                                <span class="span_value">September  1, 2026</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>

        <!-- Targeted tests for branches not covered above -->
        <x:scenario label="patient with deceased time shows death info">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget>
                        <patientRole>
                            <patient>
                                <name><given>Pat</given><family>Deceased</family></name>
                                <birthTime value="19500101"/>
                                <deceasedInd value="true"/>
                                <deceasedTime value="20200615"/>
                            </patient>
                        </patientRole>
                    </recordTarget>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows deceased label" test="contains(string(.), 'Birthdate/Deceased')"/>
            <x:expect label="shows death date" test="contains(string(.), 'June') and contains(string(.), '2020')"/>
            <x:expect label="shows dagger symbol" test="contains(string(.), '&#8224;')"/>
        </x:scenario>

        <x:scenario label="patient with deceasedInd nullFlavor">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget>
                        <patientRole>
                            <patient>
                                <name><given>Pat</given><family>Unknown</family></name>
                                <birthTime value="19500101"/>
                                <deceasedInd nullFlavor="UNK"/>
                            </patient>
                        </patientRole>
                    </recordTarget>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows deceased label" test="contains(string(.), 'Birthdate/Deceased')"/>
            <x:expect label="shows unknown nullFlavor" test="contains(string(.), 'unknown')"/>
        </x:scenario>

        <x:scenario label="patient with deceasedInd true but no deceasedTime">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget>
                        <patientRole>
                            <patient>
                                <name><given>Pat</given><family>DateUnknown</family></name>
                                <birthTime value="19500101"/>
                                <deceasedInd value="true"/>
                            </patient>
                        </patientRole>
                    </recordTarget>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows date unknown" test="contains(string(.), 'date unknown')"/>
        </x:scenario>

        <x:scenario label="author as device shows software name">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <author>
                        <assignedAuthor>
                            <assignedAuthoringDevice>
                                <softwareName>EHR System v5</softwareName>
                            </assignedAuthoringDevice>
                        </assignedAuthor>
                    </author>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows software name" test="contains(string(.), 'EHR System v5')"/>
        </x:scenario>

        <x:scenario label="documentationOf with ACT classCode omits class display">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <documentationOf>
                        <serviceEvent classCode="ACT">
                            <code displayName="General Exam"/>
                        </serviceEvent>
                    </documentationOf>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows code without class label" test="contains(string(//xhtml:tr[xhtml:td = 'Documentation&#160;Of']), 'General Exam') and not(contains(string(//xhtml:tr[xhtml:td = 'Documentation&#160;Of']), 'act'))"/>
        </x:scenario>

        <x:scenario label="multipleBirth indicator shows in header">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget>
                        <patientRole>
                            <patient>
                                <name><given>Twin</given><family>Baby</family></name>
                                <birthTime value="20260101"/>
                                <multipleBirthInd value="true"/>
                            </patient>
                        </patientRole>
                    </recordTarget>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows multiple birth indicator" test="contains(string(.), 'Multiple Birth')"/>
        </x:scenario>

        <x:scenario label="author as DTr2 assignedDevice shows software name">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <author>
                        <assignedAuthor>
                            <assignedDevice>
                                <softwareName value="DTr2 Device Software"/>
                            </assignedDevice>
                        </assignedAuthor>
                    </author>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows DTr2 software name" test="contains(string(.), 'DTr2 Device Software')"/>
        </x:scenario>
        
        <x:scenario label="author org with id but no name looks up name remotely">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <author>
                        <assignedAuthor>
                            <assignedPerson><name><given>Doc</given></name></assignedPerson>
                            <representedOrganization>
                                <id root="9.8.7.6" extension="ORG-UNKNOWN"/>
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                    <!-- Won't be rendered, but will be used as name if id matches -->
                    <fakeElement>
                        <id root="9.8.7.6" extension="ORG-UNKNOWN"/>
                        <name>Remote Name</name>
                    </fakeElement>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows org id as fallback" test="exists(//xhtml:span[text() = 'Remote Name'])"/>
        </x:scenario>
        
        <x:scenario label="author org with id but no name looks up name remotely">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <author>
                        <assignedAuthor>
                            <assignedPerson><name><given>Doc</given></name></assignedPerson>
                            <representedOrganization>
                                <id root="9.8.7.6" />
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                    <!-- Won't be rendered, but will be used as name if id matches -->
                    <fakeElement>
                        <id root="9.8.7.6" />
                        <name>Root-only is risky</name>
                    </fakeElement>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows org id as fallback" test="exists(//xhtml:span[text() = 'Root-only is risky'])"/>
        </x:scenario>

        <x:scenario label="author org with id but no name falls back to show-id-set">
            <!-- Org has an id but no name, and no matching entity elsewhere in doc,
                 so $organizationName is empty and the otherwise branch renders show-id-set -->
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <author>
                        <assignedAuthor>
                            <assignedPerson><name><given>Doc</given></name></assignedPerson>
                            <representedOrganization>
                                <id root="9.8.7.6" extension="ORG-UNKNOWN"/>
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows org id as fallback" test="exists(//xhtml:span[text() = 'ORG-UNKNOWN (9.8.7.6)'])"/>
        </x:scenario>

        <x:scenario label="author org with empty name falls back to show-id-set">
            <!-- Org has a name element but it's empty, so $organizationName is empty string -->
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <author>
                        <assignedAuthor>
                            <assignedPerson><name><given>Doc</given></name></assignedPerson>
                            <representedOrganization>
                                <id root="9.8.7.6" extension="ORG-EMPTY"/>
                                <name/>
                            </representedOrganization>
                        </assignedAuthor>
                    </author>
                </ClinicalDocument>
            </x:context>
            <x:call template="show-header"/>
            <x:expect label="shows org id as fallback" test="exists(//xhtml:span[text() = 'ORG-EMPTY (9.8.7.6)'])"/>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- make-tableofcontents / revisiontoggle / sectiontoggle              -->
    <!-- ================================================================== -->
    <x:scenario label="table of contents">
        <x:context>
            <ClinicalDocument xmlns="urn:hl7-org:v3">
                <component>
                    <structuredBody>
                        <component><section><title>A</title></section></component>
                        <component>
                            <section>
                                <title>B</title>
                                <component>
                                    <section ID="nonGenID">
                                        <title>B-sub</title>
                                        <component>
                                            <section><title>B-double-sub</title></section>
                                            <section ID="nonGenIDsub" nullFlavor="NA"><title>Missing NA</title></section>
                                        </component>
                                    </section>
                                    <section nullFlavor="UNK"><title>B-sub-2 Missing UNK</title></section>
                                </component>
                            </section>
                        </component>
                        <component><section nullFlavor="NI" ID="sea"><title>C</title></section></component>
                    </structuredBody>
                </component>
            </ClinicalDocument>
        </x:context>
        
        <x:expect label="generates a TOC" test="//xhtml:div[@id='buttontable']">
            <div xmlns="http://www.w3.org/1999/xhtml" id="buttontable">
                <table border="0" cellpadding="0" cellspacing="0">
                    <tbody>
                        <tr>
                            <td style="width: 35%; background-color: white;">
                                <ul id="nav">
                                    <li style="list-style: none;">
                                        <div class="span_button">Table of Contents&#160;&#8711;</div>
                                        <ul>
                                            <li><a href="#section_1">A</a></li>
                                            <li>
                                                <a href="#section_2">B ▶</a>
                                                <ul>
                                                    <li style="padding-left: 2em;">
                                                        <a href="#nonGenID">B-sub ▶</a>
                                                        <ul>
                                                            <li style="padding-left: 2em;">
                                                                <a href="#section_2.1.1">B-double-sub</a>
                                                            </li>
                                                            <li style="padding-left: 2em;">
                                                                <a href="#nonGenIDsub">Missing NA</a>
                                                            </li>
                                                        </ul>
                                                    </li>
                                                    <li style="padding-left: 2em;">
                                                        <a href="#section_2.1">B-sub-2 Missing UNK</a>
                                                    </li>
                                                </ul>
                                            </li>
                                            <li><a href="#sea">C (no information)</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            </td>
                            <td style="background-color: white;">
                                <div id="sectionsToggleExpand"
                                    style="display: none;"
                                    class="span_button"
                                    onclick="expandAllSections();">Expand All</div>
                                <div id="sectionsToggleCollapse"
                                    class="span_button"
                                    onclick="collapseAllSections();">Collapse All</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </x:expect>
        <x:expect label="revision toggle does not show up if there are is no revised content"
            test="empty(//xhtml:td[@id='revisionToggleOn'])"/>
        <x:scenario label="document with revision">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <component>
                        <structuredBody>
                            <component>
                                <section><title>Non-revised</title></section>
                                <section>
                                    <title>Revised</title>
                                    <text><content revised="delete" /></text>
                                </section>
                            </component>
                        </structuredBody>
                    </component>
                </ClinicalDocument>
            </x:context>
            <x:expect label="generates a revision toggle" test="(//xhtml:div[@id='buttontable']//xhtml:td)[2]">
                <td xmlns="http://www.w3.org/1999/xhtml"
                    style="background-color: white;">
                    <div id="revisionToggleOn"
                        class="span_button"
                        onclick="showReviewMarks();">Show Revisions</div>
                    <div id="revisionToggleOff"
                        style="display: none;"
                        class="span_button"
                        onclick="hideReviewMarks();">Hide Revisions</div>
                </td>
            </x:expect>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- documentfooter sections                                            -->
    <!-- ================================================================== -->

    <!-- ================================================================== -->
    <!-- documentGeneral template                                           -->
    <!-- ================================================================== -->
    <x:scenario label="documentGeneral (footer) template">
        <x:scenario label="renders document id, version, setId, effectiveTime, and statusCode">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <id root="2.16.840.1.113883.19.5" extension="DOC-001"/>
                    <effectiveTime value="20260901120000"/>
                    <versionNumber value="2"/>
                    <setId root="2.16.840.1.113883.19.5" extension="SET-001"/>
                    <statusCode code="completed"/>
                </ClinicalDocument>
            </x:context>
            <x:call template="documentGeneral"/>
            <x:expect label="produces header_table with document details">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Document</td>
                            <td style="width: 30%;">
                                <table class="table_simple">
                                    <tbody>
                                        <tr>
                                            <td class="td_label">ID</td>
                                            <td><span>DOC-001 (2.16.840.1.113883.19.5)</span></td>
                                        </tr>
                                        <tr>
                                            <td class="td_label">Version</td>
                                            <td>2</td>
                                        </tr>
                                        <tr>
                                            <td class="td_label">Set&#8209;ID</td>
                                            <td><span>SET-001 (2.16.840.1.113883.19.5)</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td class="td_label td_label_width">Created On</td>
                            <td>September  1, 2026, 12AM<table class="table_simple">
                                    <tbody>
                                        <tr>
                                            <td class="td_label">Status</td>
                                            <td><b>Completed</b></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
    <!-- relatedDocument template                                           -->
    <!-- ================================================================== -->
    <x:scenario label="relatedDocument template">
        <x:scenario label="renders multiple related documents with inversionInd variants">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <!-- inversionInd absent (default) with full parentDocument -->
                    <relatedDocument typeCode="RPLC">
                        <parentDocument>
                            <id root="2.16.840.1.113883.19.5" extension="PREV-001"/>
                            <versionNumber value="1"/>
                            <setId root="2.16.840.1.113883.19.5" extension="SET-001"/>
                        </parentDocument>
                    </relatedDocument>
                    <!-- inversionInd=true -->
                    <relatedDocument typeCode="APND" inversionInd="true">
                        <parentDocument>
                            <id root="2.16.840.1.113883.19.5" extension="CHILD-001"/>
                        </parentDocument>
                    </relatedDocument>
                    <!-- inversionInd=false (explicit) -->
                    <relatedDocument typeCode="XFRM" inversionInd="false">
                        <parentDocument>
                            <id root="2.16.840.1.113883.19.5" extension="SRC-001"/>
                        </parentDocument>
                    </relatedDocument>
                </ClinicalDocument>
            </x:context>
            <x:call template="relatedDocument"/>
            <x:expect label="produces three header tables for each relatedDocument">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">This document relates to document (replaces)</td>
                            <td style="width: 80%;">
                                <table class="table_simple">
                                    <tbody>
                                        <tr>
                                            <td class="td_label">ID</td>
                                            <td><span>PREV-001 (2.16.840.1.113883.19.5)</span></td>
                                        </tr>
                                        <tr>
                                            <td class="td_label">Version</td>
                                            <td>1</td>
                                        </tr>
                                        <tr>
                                            <td class="td_label">Set&#8209;ID</td>
                                            <td><span>SET-001 (2.16.840.1.113883.19.5)</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Document relating to this document (appendage)</td>
                            <td style="width: 80%;">
                                <table class="table_simple">
                                    <tbody>
                                        <tr>
                                            <td class="td_label">ID</td>
                                            <td><span>CHILD-001 (2.16.840.1.113883.19.5)</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">This document relates to document (transformation)</td>
                            <td style="width: 80%;">
                                <table class="table_simple">
                                    <tbody>
                                        <tr>
                                            <td class="td_label">ID</td>
                                            <td><span>SRC-001 (2.16.840.1.113883.19.5)</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
    </x:scenario>
    
    <!-- ================================================================== -->
