        <x:scenario label="renders providerOrganization with id">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget>
                        <patientRole>
                            <id root="2.16.840.1.113883.19.5" extension="P-003"/>
