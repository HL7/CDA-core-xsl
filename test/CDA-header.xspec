    <!-- ================================================================== -->
    <!-- recordTarget template                                              -->
    <!-- ================================================================== -->
    <x:scenario label="recordTarget template">
        <x:scenario label="renders full patient with all demographics, guardian, and provider org">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc">
                    <effectiveTime value="20260901"/>
                    <recordTarget>
                        <patientRole>
                            <id root="2.16.840.1.113883.19.5" extension="P-001"/>
                            <addr><city>Anytown</city></addr>
                            <telecom value="tel:555-1234"/>
                            <patient>
                                <name>
                                    <given>Jane</given> <family>Doe</family>
                                </name>
                                <administrativeGenderCode code="F" displayName="Female"/>
                                <birthTime value="19900115"/>
                                <raceCode code="2106-3" displayName="White"/>
                                <sdtc:raceCode code="2076-8" displayName="Native Hawaiian"/>
                                <ethnicGroupCode code="2186-5" displayName="Not Hispanic"/>
                                <sdtc:ethnicGroupCode code="2186-5" displayName="Not Hispanic or Latino"/>
                                <languageCommunication>
                                    <languageCode code="en"/>
                                    <modeCode displayName="Expressed spoken"/>
                                    <proficiencyLevelCode displayName="Good"/>
                                    <preferenceInd value="true"/>
                                </languageCommunication>
                                <languageCommunication>
                                    <languageCode code="es"/>
                                </languageCommunication>
                                <guardian>
                                    <code code="GRPRN" displayName="Grandparent"/>
                                    <addr><city>Guardianville</city></addr>
                                    <telecom value="tel:555-9999"/>
                                    <guardianPerson>
                                        <name>
                                            <given>Bob</given> <family>Guardian</family>
                                        </name>
                                    </guardianPerson>
                                </guardian>
                            </patient>
                            <providerOrganization>
                                <name>Good Health Clinic</name>
                                <telecom value="tel:555-0000"/>
                            </providerOrganization>
                        </patientRole>
                    </recordTarget>
                </ClinicalDocument>
            </x:context>
            <x:call template="recordTarget"/>
            <x:expect label="produces complete patient table with all rows">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Patient</td>
                            <td style="width: 30%;">Jane  DOE</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td style="width: 30%;">Anytown<br/>Tel: 555-1234</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Date of Birth</td>
                            <td style="width: 30%;">January  15, 1990 (36yr)</td>
                            <td class="td_label td_label_width">Gender</td>
                            <td>Female</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Race</td>
                            <td style="width: 30%;">White, Native Hawaiian</td>
                            <td class="td_label td_label_width">Ethnicity</td>
                            <td>Not Hispanic, Not Hispanic or Latino</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Patient-IDs</td>
                            <td><span>P-001 (2.16.840.1.113883.19.5)</span></td>
                            <td class="td_label td_label_width">Language Communication</td>
                            <td colspan="3">
                                <div>en, Expressed spoken, Good, preferred: yes</div>
                                <div>es</div>
                            </td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Guardian</td>
                            <td style="width: 30%;">Bob  GUARDIAN - Grandparent</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td>Guardianville<br/>Tel: 555-9999</td>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Provider Organization</td>
                            <td style="width: 30%;">
                                <div>Good Health Clinic</div>
                            </td>
                            <td class="td_label td_label_width">Contact Details (Organization)</td>
                            <td style="width: 30%;">Tel: 555-0000</td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>

        <x:scenario label="renders deceased patient">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget>
                        <patientRole>
                            <id root="2.16.840.1.113883.19.5" extension="P-002"/>
                            <patient>
                                <name><given>Pat</given> <family>Deceased</family></name>
                                <birthTime value="19500101"/>
                                <deceasedInd value="true"/>
                                <deceasedTime value="20200615"/>
                            </patient>
                        </patientRole>
                    </recordTarget>
                </ClinicalDocument>
            </x:context>
            <x:call template="recordTarget"/>
            <x:expect label="produces table with deceased label and death date">
                <table xmlns="http://www.w3.org/1999/xhtml" class="header_table">
                    <tbody>
                        <tr>
                            <td class="td_label td_label_width">Patient</td>
                            <td style="width: 30%;">Pat  DECEASED</td>
                            <td class="td_label td_label_width">Contact Details</td>
                            <td style="width: 30%;"/>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Birthdate/Deceased</td>
                            <td style="width: 30%;">January  1, 1950 - June  15, 2020 (70yr)</td>
                            <td class="td_label td_label_width">Gender</td>
                            <td/>
                        </tr>
                        <tr>
                            <td class="td_label td_label_width">Patient-IDs</td>
                            <td colspan="3"><span>P-002 (2.16.840.1.113883.19.5)</span></td>
                        </tr>
                    </tbody>
                </table>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="deceasedInd with nullFlavor (no deceasedTime)">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget><patientRole><id root="1.2.3" extension="P1"/>
                            <patient>
                                <name><given>Dec</given><family>NullInd</family></name>
                                <birthTime value="19800601"/>
                                <deceasedInd nullFlavor="UNK"/>
                            </patient>
                    </patientRole></recordTarget>
                </ClinicalDocument>
            </x:context>
            <x:call template="recordTarget"/>
            <!-- deceasedInd/@nullFlavor → show-nullFlavor renders "unknown", no age shown -->
            <x:expect label="shows birth date - unknown (nullFlavor)"
                test="($x:result//xhtml:tr)[2]">
                <tr xmlns="http://www.w3.org/1999/xhtml">
                    <td class="td_label td_label_width">Birthdate/Deceased</td>
                    <td style="width: 30%;">June  1, 1980 - unknown</td>
                    <td class="td_label td_label_width">Gender</td>
                    <td/>
                </tr>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="deceasedTime with nullFlavor (no deceasedInd)">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget><patientRole><id root="1.2.3" extension="P2"/>
                            <patient>
                                <name><given>Dec</given><family>NullTime</family></name>
                                <birthTime value="19800601"/>
                                <deceasedTime nullFlavor="UNK"/>
                            </patient>
                    </patientRole></recordTarget>
                </ClinicalDocument>
            </x:context>
            <x:call template="recordTarget"/>
            <!-- deceasedTime without @value, no deceasedInd → otherwise: †date unknown -->
            <x:expect label="shows birth date with dagger and date unknown"
                test="($x:result//xhtml:tr)[2]">
                <tr xmlns="http://www.w3.org/1999/xhtml">
                    <td class="td_label td_label_width">Birthdate/Deceased</td>
                    <td style="width: 30%;">June  1, 1980 - &#8224;date unknown</td>
                    <td class="td_label td_label_width">Gender</td>
                    <td/>
                </tr>
            </x:expect>
        </x:scenario>
        
        <x:scenario label="multipleBirthInd true (no order number)">
            <x:context>
                <ClinicalDocument xmlns="urn:hl7-org:v3">
                    <effectiveTime value="20260901"/>
                    <recordTarget><patientRole><id root="1.2.3" extension="P4"/>
